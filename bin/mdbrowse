#!/usr/bin/env bash
# mdbrowse — render a Markdown file to a fixed HTML path so the
# browser tab can stay open and just swap its contents.
set -euo pipefail

VERSION="0.3.3"
PROG="$(basename "$0")"
OUT="${MDBROWSE_OUT:-/tmp/mdbrowse.html}"
case "$OUT" in
  *.html) ;;
  *) echo "$(basename "$0"): MDBROWSE_OUT must end with .html (got: $OUT)" >&2; exit 2 ;;
esac
STAMP="${OUT%.html}-stamp.js"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/mdbrowse"

# スタイルシートの探索順
#   1. MDBROWSE_HEAD
#   2. ユーザー設定 ~/.config/mdbrowse/head.html
#   3. 同梱のもの（npm でインストールした場合はここが使われる）
resolve_dir() {
  local src="$1" dir
  while [ -L "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  (cd -P "$(dirname "$src")" && pwd)
}
BUNDLED_HEAD="$(resolve_dir "$0")/../assets/head.html"

if [ -n "${MDBROWSE_HEAD:-}" ]; then
  HEAD="$MDBROWSE_HEAD"
elif [ -f "$CONFIG_DIR/head.html" ]; then
  HEAD="$CONFIG_DIR/head.html"
else
  HEAD="$BUNDLED_HEAD"
fi

usage() {
  cat <<'USAGE'
mdb — render Markdown to a fixed HTML file for browser preview

Usage:
  mdb                    open the preview tab and keep it in sync from then on
  mdb <file.md>          render that file once
  mdb --stop             stop the background sync
  mdb --status           show what is being previewed
  mdb --install-agent    start the sync automatically at every login (macOS)
  mdb --uninstall-agent  remove it
  mdb -w <file|dir>      watch in the foreground instead (Ctrl-C to stop)
  mdb --eject            copy the bundled stylesheet into your config directory
  mdb --path             print the output HTML path
  mdb --version          print the version

With no arguments, mdb opens the preview tab and starts a small background
process. From then on, whatever Markdown file you save — in any project, from
any editor — shows up in that tab. Nothing else to set up. `mdb --stop` ends it,
and it is gone after a logout or a reboot.

`mdb --install-agent` makes it start on its own at every login, so you never
have to think about starting or stopping it. It writes a LaunchAgent under
~/Library/LaunchAgents and nothing else; `mdb --uninstall-agent` removes it.

Finding the file you just saved uses Spotlight (mdfind). Files under hidden
directories, node_modules and ~/Library are ignored. Without Spotlight, mdb
falls back to watching the directory you started it in.

The same command is also installed under its full name, `mdbrowse`.

Environment:
  MDBROWSE_OUT    output HTML path   (default: /tmp/mdbrowse.html)
  MDBROWSE_HEAD   stylesheet/header  (default: $XDG_CONFIG_HOME/mdbrowse/head.html)

Rendering also writes a stamp file next to the output. The page watches that
stamp and reloads only when you render something new, so pointing the editor at
a different file swaps the contents of the same tab instead of opening one.
USAGE
}

open_url() {
  if command -v open >/dev/null 2>&1; then open "file://$OUT"
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "file://$OUT"
  else echo "file://$OUT"
  fi
}

# まだ何も変換していないときの仮ページ。スタイルシートごと入れるので、
# 更新の監視も目次もバーも、ふつうのページと同じように動く
placeholder() {
  printf '%s\n' '<!doctype html><meta charset="utf-8"><title>mdbrowse</title>'
  [ -f "$HEAD" ] && cat "$HEAD"
  printf '%s\n' '<p>No preview yet. Save a Markdown file.'
}

open_tab() {
  [ -f "$OUT" ] || placeholder > "$OUT"
  [ -f "$STAMP" ] || printf 'window.__mdbrowseStamp="0";\n' > "$STAMP"
  open_url
}

# PID・ログ・ロックは自分だけが書ける場所に置く。共有の /tmp に固定名で置くと、
# 先に symlink を作られたときに書き込み先を差し替えられる
RUNTIME_DIR="${TMPDIR:-/tmp}/mdbrowse-$(id -u)"
( umask 077; mkdir -p "$RUNTIME_DIR" ) 2>/dev/null || true
LOGFILE="$RUNTIME_DIR/sync.log"
LOCKDIR="$RUNTIME_DIR/sync.lock"
PIDFILE="$LOCKDIR/pid"
LEGACY_PIDFILE="${OUT%.html}-sync.pid"

running_pid() {
  [ -f "$PIDFILE" ] || return 1
  local pid; pid="$(cat "$PIDFILE" 2>/dev/null)"
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  # PID は使い回される。中身が自分のプロセスか確かめてから扱う
  ps -p "$pid" -o command= 2>/dev/null | grep -q -- '--sync-daemon' || return 1
  echo "$pid"
}

stop_sync() {
  local pid stopped=0 i=0
  if pid="$(running_pid)"; then
    kill "$pid" 2>/dev/null || true
    while [ $i -lt 30 ]; do
      kill -0 "$pid" 2>/dev/null || break
      i=$(( i + 1 ))
      sleep 0.1
    done
    stopped=1
  fi
  # 0.2.x が置いた古い場所のものも拾う
  if [ -f "$LEGACY_PIDFILE" ]; then
    local old; old="$(cat "$LEGACY_PIDFILE" 2>/dev/null || true)"
    if [ -n "$old" ] && kill -0 "$old" 2>/dev/null; then
      kill "$old" 2>/dev/null || true
      stopped=1
    fi
    rm -f "$LEGACY_PIDFILE"
  fi
  rm -rf "$LOCKDIR"
  if [ "$stopped" -eq 1 ]; then echo "$PROG: stopped"; else echo "$PROG: not running"; fi
}

# ログイン時の自動起動があることを、初回だけ1行で知らせる。
# 毎回出すと邪魔になるので、一度出したら記録して黙る
hint_agent() {
  [ "$(uname -s)" = "Darwin" ] || return 0
  agent_installed && return 0
  [ -f "$RUNTIME_DIR/agent-hint" ] && return 0
  mkdir -p "$RUNTIME_DIR" 2>/dev/null || true
  : > "$RUNTIME_DIR/agent-hint" 2>/dev/null || true
  echo "$PROG: it stops at logout — 'mdb --install-agent' starts it at every login"
}

start_sync() {
  if running_pid >/dev/null; then
    echo "$PROG: already in sync (mdb --stop to end it)"
    return 0
  fi
  # PID は起動した本人に書かせる。すぐ落ちた場合に死んだ PID を残さないため
  nohup "$0" --sync-daemon "$PWD" >/dev/null 2>&1 &
  local i=0
  while [ $i -lt 20 ]; do
    running_pid >/dev/null && break
    i=$(( i + 1 ))
    sleep 0.1
  done
  if running_pid >/dev/null; then
    echo "$PROG: in sync — save any .md and it shows up here (mdb --stop to end it)"
    hint_agent
  else
    echo "$PROG: could not start the background sync (see $LOGFILE)" >&2
    return 1
  fi
}

AGENT_LABEL="com.commte.mdbrowse"
AGENT_PLIST="$HOME/Library/LaunchAgents/$AGENT_LABEL.plist"

agent_installed() { [ -f "$AGENT_PLIST" ]; }

install_agent() {
  if [ "$(uname -s)" != "Darwin" ]; then
    echo "$PROG: --install-agent is macOS only" >&2
    return 1
  fi
  local self; self="$(resolve_dir "$0")/$(basename "$(readlink "$0" 2>/dev/null || echo "$0")")"
  [ -x "$self" ] || self="$0"

  # launchd の PATH は最小限なので、pandoc と node の場所を書き込んでおく
  local paths="/usr/bin:/bin:/usr/sbin:/sbin"
  local d
  for d in "$(command -v pandoc)" "$(command -v node)" "$(command -v mdfind)"; do
    [ -n "$d" ] && paths="$(dirname "$d"):$paths"
  done

  mkdir -p "$HOME/Library/LaunchAgents"
  {
    printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>'
    printf '%s\n' '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">'
    printf '%s\n' '<plist version="1.0">'
    printf '%s\n' '<dict>'
    printf '  <key>Label</key><string>%s</string>\n' "$AGENT_LABEL"
    printf '%s\n' '  <key>ProgramArguments</key>'
    printf '%s\n' '  <array>'
    printf '    <string>%s</string>\n' "$self"
    printf '%s\n' '    <string>--sync-daemon</string>'
    printf '    <string>%s</string>\n' "$HOME"
    printf '%s\n' '  </array>'
    printf '%s\n' '  <key>RunAtLoad</key><true/>'
    printf '%s\n' '  <key>KeepAlive</key><false/>'
    printf '  <key>StandardErrorPath</key><string>%s</string>\n' "$LOGFILE"
    printf '%s\n' '  <key>EnvironmentVariables</key>'
    printf '%s\n' '  <dict>'
    printf '    <key>PATH</key><string>%s</string>\n' "$paths"
    [ -n "${MDBROWSE_OUT:-}" ] && printf '    <key>MDBROWSE_OUT</key><string>%s</string>\n' "$MDBROWSE_OUT"
    [ -n "${MDBROWSE_HEAD:-}" ] && printf '    <key>MDBROWSE_HEAD</key><string>%s</string>\n' "$MDBROWSE_HEAD"
    printf '%s\n' '  </dict>'
    printf '%s\n' '</dict>'
    printf '%s\n' '</plist>'
  } > "$AGENT_PLIST"

  launchctl bootout "gui/$(id -u)/$AGENT_LABEL" 2>/dev/null || true
  if ! launchctl bootstrap "gui/$(id -u)" "$AGENT_PLIST" 2>/dev/null; then
    launchctl load -w "$AGENT_PLIST" 2>/dev/null || true
  fi
  echo "$PROG: starts at login now ($AGENT_PLIST)"
}

uninstall_agent() {
  launchctl bootout "gui/$(id -u)/$AGENT_LABEL" 2>/dev/null \
    || launchctl unload -w "$AGENT_PLIST" 2>/dev/null || true
  if [ -f "$AGENT_PLIST" ]; then
    rm -f "$AGENT_PLIST"
    echo "$PROG: will not start at login any more"
  else
    echo "$PROG: not installed"
  fi
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  --install-agent) install_agent; exit $? ;;
  --uninstall-agent) uninstall_agent; exit 0 ;;
  -v|--version) echo "mdbrowse $VERSION"; exit 0 ;;
  --path) echo "$OUT"; exit 0 ;;
  --stop) stop_sync; exit 0 ;;
  --status)
    if running_pid >/dev/null; then
      echo "$PROG: in sync (pid $(running_pid))"
    else
      echo "$PROG: not running"
    fi
    if agent_installed; then
      echo "starts at login: yes ($AGENT_PLIST)"
    else
      echo "starts at login: no (mdb --install-agent to change that)"
    fi
    [ -f "$OUT" ] && echo "showing: $(grep -o '<title>[^<]*' "$OUT" 2>/dev/null | sed 's/<title>//')"
    exit 0 ;;
  --eject)
    mkdir -p "$CONFIG_DIR"
    if [ -f "$CONFIG_DIR/head.html" ] && [ "${2:-}" != "--force" ]; then
      echo "$PROG: $CONFIG_DIR/head.html already exists (pass --force to overwrite)" >&2
      exit 1
    fi
    cp "$BUNDLED_HEAD" "$CONFIG_DIR/head.html"
    echo "$CONFIG_DIR/head.html"
    exit 0 ;;
esac

# 残りは「オプション＋ファイル」
watch=0
do_open=0
daemon=0
sync_cwd=""
src=""
while [ $# -gt 0 ]; do
  case "$1" in
    -w|--watch) watch=1 ;;
    -o|--open) do_open=1 ;;
    --sync-daemon) daemon=1; shift; sync_cwd="${1:-$PWD}" ;;
    --) shift; [ $# -gt 0 ] && src="$1"; break ;;
    -*) echo "$PROG: unknown option: $1" >&2; exit 2 ;;
    *)
      if [ -n "$src" ]; then
        echo "$PROG: too many files: $1" >&2
        exit 2
      fi
      src="$1" ;;
  esac
  shift || break
done

# 引数なし（または --open だけ）が既定の使い方。タブを開いて、以後は勝手に追従する
if [ -z "$src" ] && [ "$watch" -eq 0 ] && [ "$daemon" -eq 0 ]; then
  # --open だけを渡された場合はタブを開くだけ（エディタのタスクから呼ばれる経路）
  if [ "$do_open" -eq 1 ]; then
    open_tab
    exit 0
  fi
  if ! command -v pandoc >/dev/null 2>&1; then
    echo "$PROG: pandoc not found. Install it first (macOS: brew install pandoc)" >&2
    exit 127
  fi
  open_tab
  start_sync
  exit 0
fi

# -w だけならカレントディレクトリを見る
[ -z "$src" ] && [ "$watch" -eq 1 ] && src="."

if ! command -v pandoc >/dev/null 2>&1; then
  echo "$PROG: pandoc not found. Install it first (macOS: brew install pandoc)" >&2
  exit 127
fi
root=""
if [ "$daemon" -eq 1 ]; then
  :
elif [ -d "$src" ]; then
  if [ "$watch" -eq 0 ]; then
    echo "$PROG: $src is a directory (pass -w to watch it)" >&2
    exit 2
  fi
  root="$src"
elif [ ! -f "$src" ]; then
  echo "$PROG: no such file: $src" >&2
  exit 66
fi

# コードの色付けは Shiki（node がある場合）。無ければ pandoc 内蔵の skylighting
SELF_DIR="$(resolve_dir "$0")"
HIGHLIGHTER="$SELF_DIR/../lib/highlight.mjs"
use_shiki=0
if command -v node >/dev/null 2>&1 && [ -f "$HIGHLIGHTER" ]; then
  use_shiki=1
fi

# シンタックスハイライトの指定は pandoc 3.9 で名前が変わった。
# sort -V は POSIX に無いので、major と minor を数として比べる
pv="$(pandoc --version | head -1 | awk '{print $2}')"
pv_major="${pv%%.*}"; pv_rest="${pv#*.}"; pv_minor="${pv_rest%%.*}"
case "$pv_major$pv_minor" in *[!0-9]*|'') pv_major=0; pv_minor=0 ;; esac
if [ "$pv_major" -gt 3 ] || { [ "$pv_major" -eq 3 ] && [ "$pv_minor" -ge 9 ]; }; then
  if [ "$use_shiki" -eq 1 ]; then hl=(--syntax-highlighting none); else hl=(--syntax-highlighting breezedark); fi
else
  if [ "$use_shiki" -eq 1 ]; then hl=(--no-highlight); else hl=(--highlight-style breezedark); fi
fi

render() {
  # 途中経過をタブに見せないため、別名で組み立ててから置き換える。
  # 名前は毎回変える。固定名だと、同時に走ったときに互いの中間結果を踏む
  local tmp
  tmp="$(mktemp "$OUT.part.XXXXXX")" || return 1

  # 出力先が .part なので、拡張子から形式を推測させず明示する
  local args=(--standalone --from gfm --to html5 "${hl[@]}" --variable "pagetitle=$(basename "$src")" --output "$tmp")
  [ -f "$HEAD" ] && args+=(--include-in-header "$HEAD")

  # 途中で失敗したら、そこで止めて古い表示を残す。
  # 関数を `render || ...` の形で呼ぶと関数の中では set -e が効かないので、各段で判定する
  pandoc "$src" "${args[@]}" || { rm -f "$tmp"; return 1; }

  # コードブロックを Shiki で色付けし直す。失敗しても変換自体は成立させる
  if [ "$use_shiki" -eq 1 ]; then
    node "$HIGHLIGHTER" "$tmp" || true
  fi

  # frontmatter の title を pandoc が拾うと本文の先頭に見出しが増えるので落とす。
  # ブラウザのタブ名には pagetitle を使っている
  perl -0pi -e 's#<header id="title-block-header">.*?</header>\n?##s' "$tmp" \
    || { rm -f "$tmp"; return 1; }

  # 出力先が /tmp なので、元ファイルからの相対パス（画像・ローカルリンク）が
  # そのままでは解決できない。ソースのあるディレクトリ基準の file:// に書き換える。
  # 書き換えるのはタグの属性だけ。本文中の src="..." のようなインラインコードは触らない。
  # スキーム付き（http(s) data: mailto: など）／絶対パス／ページ内アンカーはそのまま残す
  local src_dir
  src_dir="$(cd "$(dirname "$src")" && pwd)" || { rm -f "$tmp"; return 1; }
  MDBROWSE_SRC_DIR="$src_dir" perl -0pi -e '
  BEGIN {
    $base = $ENV{MDBROWSE_SRC_DIR};
    # file:// の中で意味を持つ文字は先に逃がす（% は必ず最初）
    $base =~ s/%/%25/g;
    $base =~ s/#/%23/g;
    $base =~ s/\?/%3F/g;
    $base =~ s/&/%26/g;
    $base =~ s/"/%22/g;
    $base =~ s/ /%20/g;
  }
  # 属性値の中の > でタグを切らないよう、引用符の中はまとめて食う
  s{(<(?:img|a|source|video|audio|embed|object|track)\b)((?:[^>"\x27]|"[^"]*"|\x27[^\x27]*\x27)*)(>)}{
    my ($tag, $attrs, $close) = ($1, $2, $3);
    $attrs =~ s{((?:src|href|poster|data)=")(?![a-zA-Z][a-zA-Z0-9+.\-]*:|//|/|\#|")([^"]*)"}
               {$1 . "file://" . $base . "/" . $2 . "\""}ge;
    $attrs =~ s{((?:src|href|poster|data)=\x27)(?![a-zA-Z][a-zA-Z0-9+.\-]*:|//|/|\#|\x27)([^\x27]*)\x27}
               {$1 . "file://" . $base . "/" . $2 . "\x27"}ge;
    $tag . $attrs . $close;
  }gse;
' "$tmp" || { rm -f "$tmp"; return 1; }

  mv -f "$tmp" "$OUT" || { rm -f "$tmp"; return 1; }

  # 更新の目印。ブラウザはこれを見て、中身が変わったときだけ読み直す。
  # 本体の差し替えが済んでから書く
  local stamp_tmp
  stamp_tmp="$(mktemp "$STAMP.part.XXXXXX")" || return 1
  printf 'window.__mdbrowseStamp="%s";\n' "$(date +%s)-$RANDOM" > "$stamp_tmp" \
    || { rm -f "$stamp_tmp"; return 1; }
  mv -f "$stamp_tmp" "$STAMP" || { rm -f "$stamp_tmp"; return 1; }
}

# ファイルの更新時刻とサイズ。同じ秒内の2回目の保存も拾えるようにサイズも見る
if stat -f %m . >/dev/null 2>&1; then
  fingerprint() { stat -f '%Fm %z %i' "$1" 2>/dev/null || true; }
  stat_time_name() { xargs -0 stat -f '%m %N' 2>/dev/null || true; }
else
  fingerprint() { stat -c '%.9Y %s %i' "$1" 2>/dev/null || true; }
  stat_time_name() { xargs -0 stat -c '%Y %n' 2>/dev/null || true; }
fi

# 「更新時刻 パス」の行から、いちばん新しい1件を返す。
# sort と head の組み合わせは、件数が多いと head の SIGPIPE で pipefail に引っかかる
pick_newest() {
  awk '$1 > m { m = $1; sub(/^[0-9]+ /, ""); f = $0 } END { if (f != "") print f }'
}

# ディレクトリの中でいちばん最近保存された Markdown
newest_md() {
  find "$1" \( -name .git -o -name node_modules -o -name .venv \) -prune \
       -o -type f -name '*.md' -print0 2>/dev/null \
    | stat_time_name | pick_newest || true
}

# Spotlight で「家じゅうで直近に保存された Markdown」を引く。木を歩かないので速い
# 該当が無いときは grep が 1 を返す。pipefail に拾わせると背景プロセスが即死するので握る
newest_global() {
  mdfind 'kMDItemFSName == "*.md"c && kMDItemContentModificationDate >= $time.now(-1800)' 2>/dev/null \
    | grep -v -e '/\.' -e '/node_modules/' -e '/Library/' \
    | tr '\n' '\0' | stat_time_name | pick_newest || true
}

# 背景で動く本体。保存された Markdown を追いかけて変換し続ける
if [ "$daemon" -eq 1 ]; then
  # 確認と取得を1操作にする。mkdir は原子的なので、同時に叩かれても1つしか通らない
  if ! mkdir "$LOCKDIR" 2>/dev/null; then
    # 取れなかった側は、持ち主が名乗るのを少し待つ。
    # すぐ「持ち主なし」と判断すると、書き込み前の相手からロックを奪ってしまう
    i=0
    while [ $i -lt 30 ]; do
      running_pid >/dev/null && exit 0
      i=$(( i + 1 ))
      sleep 0.1
    done
    # 3秒待っても名乗らないなら、置き去りのロックとして回収する
    rm -rf "$LOCKDIR"
    mkdir "$LOCKDIR" 2>/dev/null || exit 0
  fi
  echo $$ > "$PIDFILE"
  # 自分が持っているときだけ外す。あとから起きたものの分を消さないため
  trap 'if [ "$(cat "$PIDFILE" 2>/dev/null)" = "$$" ]; then rm -rf "$LOCKDIR"; fi' EXIT
  use_spotlight=0
  command -v mdfind >/dev/null 2>&1 && use_spotlight=1
  if [ "$use_spotlight" -eq 0 ]; then root="$sync_cwd"; fi

  pick() {
    if [ "$use_spotlight" -eq 1 ]; then newest_global; else newest_md "$root"; fi
  }

  # 変換の失敗は画面に出ないので、ログに残す
  log() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "$LOGFILE"; }

  # 表示中のファイルは 0.25 秒ごとに見る。1周 = 0.25 秒
  TICK=0.25
  # Spotlight への問い合わせは 2 秒ごと（8周に1回）
  scan_gap=8
  if [ "$use_spotlight" -eq 0 ]; then
    t0="$(perl -MTime::HiRes=time -e 'printf "%d", time*1000')"
    newest_md "$root" >/dev/null
    t1="$(perl -MTime::HiRes=time -e 'printf "%d", time*1000')"
    scan_gap=$(( ( (t1 - t0) * 5 + 249) / 250 ))
    [ "$scan_gap" -lt 8 ] && scan_gap=8
    [ "$scan_gap" -gt 40 ] && scan_gap=40
    log "watching $root every $(( scan_gap / 4 ))s (no Spotlight)"
  fi

  src="$(pick)"
  if [ -n "$src" ] && [ -f "$src" ]; then render || log "render failed: $src"; fi
  last="$src $(fingerprint "$src") $(fingerprint "$HEAD")"
  # 開いているファイルの保存は毎秒見る。別ファイルへの切り替えの検出は2秒ごと
  tick=0
  while sleep "$TICK"; do
    tick=$(( tick + 1 ))
    if [ $(( tick % scan_gap )) -eq 0 ]; then
      cand="$(pick)"
      if [ -n "$cand" ]; then src="$cand"; fi
    fi
    [ -n "$src" ] || continue
    [ -f "$src" ] || continue
    now="$src $(fingerprint "$src") $(fingerprint "$HEAD")"
    [ "$now" = "$last" ] && continue
    last="$now"
    render || log "render failed: $src"
  done
  exit 0
fi

if [ -n "$root" ]; then
  src="$(newest_md "$root")"
  if [ -z "$src" ]; then
    echo "$PROG: no Markdown file under $root" >&2
    exit 66
  fi
fi

[ "$do_open" -eq 1 ] && open_tab

render

# 監視。保存のたびに変換し直す。スタイルシートを直したときも作り直す
if [ "$watch" -eq 1 ]; then
  # ディレクトリを見る場合、木が大きいと走査が重い。1回の走査時間から
  # 待ち時間を決めて、CPU を食い潰さないようにする
  interval=0.25
  if [ -n "$root" ]; then
    t0="$(perl -MTime::HiRes=time -e 'printf "%d", time*1000')"
    newest_md "$root" >/dev/null
    t1="$(perl -MTime::HiRes=time -e 'printf "%d", time*1000')"
    scan=$(( t1 - t0 ))
    interval=$(( (scan * 5 + 999) / 1000 ))
    [ "$interval" -lt 1 ] && interval=1
    [ "$interval" -gt 10 ] && interval=10
    if [ "$interval" -gt 1 ]; then
      echo "$PROG: watching $root — save any .md under it (checking every ${interval}s; a smaller directory reacts faster) (Ctrl-C to stop)" >&2
    else
      echo "$PROG: watching $root — save any .md under it (Ctrl-C to stop)" >&2
    fi
  else
    echo "$PROG: watching $src (Ctrl-C to stop)" >&2
  fi
  last="$src $(fingerprint "$src") $(fingerprint "$HEAD")"
  while sleep "$interval"; do
    if [ -n "$root" ]; then
      cand="$(newest_md "$root")"
      [ -n "$cand" ] && src="$cand"
    fi
    now="$src $(fingerprint "$src") $(fingerprint "$HEAD")"
    [ "$now" = "$last" ] && continue
    last="$now"
    [ -f "$src" ] || continue
    render || echo "$PROG: render failed" >&2
  done
fi
