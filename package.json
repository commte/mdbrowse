{
  "name": "@commte/mdbrowse",
  "version": "0.3.3",
  "description": "Preview the Markdown file you are editing in a real browser, with your own CSS, from any editor that can run a shell command. No server, no port.",
  "bin": {
    "mdbrowse": "bin/mdbrowse",
    "mdb": "bin/mdbrowse"
  },
  "files": [
    "bin/mdbrowse",
    "lib/highlight.mjs",
    "assets/head.html",
    "sample.md",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bash test/cli.sh && vitest run",
    "test:cli": "bash test/cli.sh",
    "test:browser": "vitest run"
  },
  "keywords": [
    "markdown",
    "preview",
    "pandoc",
    "editor",
    "zed",
    "neovim",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/commte/mdbrowse.git"
  },
  "homepage": "https://github.com/commte/mdbrowse#readme",
  "bugs": {
    "url": "https://github.com/commte/mdbrowse/issues"
  },
  "author": "commte",
  "license": "MIT",
  "os": [
    "darwin",
    "linux"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "vitest": "^5.0.0"
  }
}
